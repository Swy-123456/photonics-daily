---
interface Props {
  tag: string
}

const { tag } = Astro.props

// 各应用领域对应的配色
const colors: Record<string, string> = {
  光通信: 'bg-blue-100 text-blue-700 border-blue-200',
  光计算: 'bg-violet-100 text-violet-700 border-violet-200',
  传感: 'bg-emerald-100 text-emerald-700 border-emerald-200',
  量子光子学: 'bg-amber-100 text-amber-700 border-amber-200',
}
const cls = colors[tag] ?? 'bg-slate-100 text-slate-600 border-slate-200'
---

<span class={`inline-block px-2.5 py-0.5 text-xs font-medium rounded-full border ${cls}`}>
  {tag}
</span>
